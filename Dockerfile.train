# Training / evaluation image for VISION-CT (chest model and two-stage abdomen model).
#
# Build:  docker build -f Dockerfile.train -t visionct_train:latest .
# Run  :  docker run --rm --gpus all --shm-size 32g \
#           -v <data_root>:/data -v $PWD:/work -w /work visionct_train:latest \
#           bin/train_semantic_seg_two_stage.py --config_file configs/abd_step1_pretrain_seg_config.yaml
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

WORKDIR /work
COPY requirements.txt /work/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
 && python -c "import transformers, monai, timm_3d, peft, pyarrow, SimpleITK, acvl_utils, zstandard, tap; print('deps OK')"

ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python"]
